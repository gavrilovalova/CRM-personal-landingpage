---
import Chip from "./Chip.astro";
import SectionTitle from "./SectionTitle.astro";

interface Props {
  label: string;
  tone: "pink" | "lime" | "surface";
}

const { label, tone } = Astro.props;
---

<div class="flex flex-col gap-6 lg:max-w-205 lg:gap-5">
  <Chip tone={tone}>{label}</Chip>
  <SectionTitle><slot /></SectionTitle>
</div>
