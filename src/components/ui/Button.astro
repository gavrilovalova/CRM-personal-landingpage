---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "white" | "ghost";
type Size = "header" | "hero" | "final";

interface Props extends HTMLAttributes<"a"> {
  variant?: Variant;
  size?: Size;
}

const { variant = "primary", size = "hero", class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: "bg-brand text-white hover:bg-brand-hover",
  white: "bg-white text-brand hover:brightness-95 focus-visible:outline-white",
  ghost: "bg-surface text-ink hover:brightness-95",
};

const sizes: Record<Size, string> = {
  header: "h-11 rounded-14 px-4 text-15 lg:h-12 lg:rounded-16 lg:px-5.5 lg:text-16",
  hero: "h-15 rounded-20 text-18 lg:h-16 lg:rounded-22 lg:px-9 lg:text-19",
  final: "h-15 rounded-20 text-18 lg:h-17 lg:rounded-24 lg:px-10 lg:text-20",
};
---

<a
  class:list={[
    "inline-flex items-center justify-center font-bold whitespace-nowrap transition",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
