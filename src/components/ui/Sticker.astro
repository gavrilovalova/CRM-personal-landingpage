---
type Tone = "lime" | "pink";
type Size = "md" | "lg";

interface Props {
  tone: Tone;
  size?: Size;
  /** Position and tilt, e.g. "-top-4 right-4 rotate-4" */
  class?: string;
}

const { tone, size = "md", class: className } = Astro.props;

const tones: Record<Tone, string> = {
  lime: "bg-lime",
  pink: "bg-pink",
};

const sizes: Record<Size, string> = {
  md: "lg:px-4 lg:py-2.5 lg:text-15",
  lg: "lg:px-4.5 lg:py-2.5 lg:text-16",
};
---

<span
  class:list={[
    "absolute z-10 rounded-full px-3 py-2 text-13 font-bold whitespace-nowrap text-ink",
    tones[tone],
    sizes[size],
    className,
  ]}
>
  <slot />
</span>
