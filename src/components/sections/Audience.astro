---
import { audience } from "../../content/landing";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="-mt-9 rounded-t-36 bg-white lg:-mt-14 lg:rounded-t-56">
  <div class="mx-auto flex max-w-page flex-col gap-6 px-5 py-14 lg:gap-10 lg:px-10 lg:pt-26 lg:pb-16">
    <SectionHeading tone="pink" label={audience.label}>{audience.title}</SectionHeading>

    <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
      {
        audience.items.map((item) => (
          <li class="flex items-start gap-3.5 rounded-24 bg-surface p-5 md:last:col-span-2 lg:flex-col lg:gap-5 lg:rounded-28 lg:p-7 lg:last:col-span-1">
            <Icon name={item.icon} class="size-7 shrink-0 text-brand lg:size-9" />
            <span class="text-16 leading-body lg:text-18">{item.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
