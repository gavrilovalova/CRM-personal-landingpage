---
import { problem, type Tone } from "../../content/landing";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const iconTones: Partial<Record<Tone, string>> = {
  brand: "bg-brand text-white",
  lime: "bg-lime text-ink",
};
---

<section class="rounded-t-36 bg-surface lg:rounded-t-56">
  <div class="mx-auto flex max-w-page flex-col gap-6 px-5 py-14 lg:gap-10 lg:px-10 lg:pt-26 lg:pb-30">
    <SectionHeading tone="pink" label={problem.label}>{problem.title}</SectionHeading>

    <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
      {
        problem.cards.map((card) => (
          <li class="flex flex-col gap-3 rounded-24 bg-white p-5 md:last:col-span-2 lg:gap-5 lg:rounded-28 lg:p-7 lg:last:col-span-1">
            {card.tags && (
              <div class="flex flex-wrap gap-2">
                {card.tags.map((tag) => (
                  <span class="rounded-10 bg-surface px-2.5 py-1.5 text-14 font-bold lg:rounded-12 lg:px-3 lg:py-2 lg:text-15">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {card.icon && (
              <span
                class:list={[
                  "flex size-10 items-center justify-center rounded-12 lg:size-12 lg:rounded-14",
                  iconTones[card.icon.tone],
                ]}
              >
                <Icon name={card.icon.name} class="size-5.5 lg:size-6" />
              </span>
            )}
            <p class="text-16 leading-body lg:text-18">{card.text}</p>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-2 text-20 leading-punchline font-bold lg:mt-4 lg:max-w-225 lg:text-punchline lg:leading-title"
    >
      {problem.conclusion.before}{" "}
      <span class="rounded-6 bg-lime px-1 lg:rounded-8 lg:px-1.5">{problem.conclusion.highlight}</span>
    </p>
  </div>
</section>
